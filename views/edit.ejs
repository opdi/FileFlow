<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
    <a class="text-blue-500 inline-block mb-10" href="/">Go Back to home</a>
    <form action="/edit" method="post" class="space-y-3">
        <input class="block w-1/4 rounded-md outline-none px-5 py-2 text-zinc-600 bg-zinc-800" 
               type="text" placeholder="Previous file name" name="previous" value="<%= filename %>">
        <textarea class="block w-1/4 rounded-md outline-none px-5 py-2 resize-none bg-zinc-800" 
                  placeholder="New file name" name="new"></textarea>
        <input class="bg-yellow-600 hover:bg-yellow-700 transition-all rounded-md px-5 py-2 cursor-pointer" 
               type="submit" value="Update Name">
    </form>
</div>
</body>
</html>

